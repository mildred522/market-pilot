# Baidu Maps server-side key (keep secrets out of the frontend)
BAIDU_MAP_AK=

# OpenAI-compatible Agent model. Leave key/model empty for deterministic fallback.
AGENT_LLM_PROVIDER=openai-compatible
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT_SECONDS=20
